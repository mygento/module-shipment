{
    "name": "mygento/module-shipment",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "homepage": "https://github.com/mygento/module-shipment",
    "description": "Magento 2 Shipment Base",
    "authors": [
        {
            "name": "Nikita Tarasov",
            "email": "nikita@mygento.com",
            "homepage": "http://www.mygento.com/",
            "role": "Developer"
        },
        {
            "name": "Mygento",
            "email": "connect@mygento.com",
            "homepage": "https://www.mygento.com/"
        }
    ],
    "keywords": [
        "magento2",
        "mygento"
    ],
    "prefer-stable": true,
    "require": {
        "php": ">=8.0.0",
        "magento/module-shipping": "100.*",
        "mygento/module-base": "~2.4.3"
    },
    "require-dev": {
        "mygento/coding-standard": "~2.14.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Mygento\\Shipment\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": false,
            "phpro/grumphp": true
        }
    }
}
